module(
    name = "assisted-migration-agent",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_go", version = "0.64.1")
bazel_dep(name = "gazelle", version = "0.43.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Override tags are only valid in the root module. Consumers provide their own.
go_deps_root = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_root.gazelle_override(
    path = "github.com/openshift/api",
    directives = [
        "gazelle:proto disable_global",
    ],
)

go_deps_root.module_override(
    path = "github.com/duckdb/duckdb-go-bindings/linux-amd64",
    patches = ["//patches:duckdb-linux-amd64.patch"],
    patch_strip = 0,
)
use_repo(go_deps, "com_github_creasty_defaults", "com_github_duckdb_duckdb_go_v2", "com_github_ecordell_optgen", "com_github_fatih_color", "com_github_getkin_kin_openapi", "com_github_gin_contrib_zap", "com_github_gin_gonic_gin", "com_github_go_extras_cobraflags", "com_github_go_logr_logr", "com_github_go_playground_validator_v10", "com_github_golang_jwt_jwt_v5", "com_github_google_uuid", "com_github_jzelinskie_cobrautil_v2", "com_github_kubev2v_forklift", "com_github_kubev2v_migration_planner", "com_github_kubev2v_vm_migration_detective", "com_github_masterminds_squirrel", "com_github_oapi_codegen_gin_middleware", "com_github_oapi_codegen_runtime", "com_github_onsi_ginkgo_v2", "com_github_onsi_gomega", "com_github_opencontainers_runtime_spec", "com_github_sirupsen_logrus", "com_github_spf13_cobra", "com_github_spf13_pflag", "com_github_spf13_viper", "com_github_vmware_govmomi", "com_github_xuri_excelize_v2", "in_gopkg_yaml_v3", "io_k8s_api", "io_k8s_apimachinery", "io_podman_go_common", "io_podman_go_podman_v6", "org_golang_x_crypto", "org_uber_go_zap")
