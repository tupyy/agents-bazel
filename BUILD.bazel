load("@rules_go//go:def.bzl", "go_binary", "go_library")

filegroup(
    name = "main_srcs",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "assisted-migration-agent_lib",
    srcs = ["main.go"],
    importpath = "github.com/kubev2v/assisted-migration-agent",
    visibility = ["//visibility:public"],
    deps = [
        "//cmd",
        "//internal/config",
        "//pkg/logger",
        "//vendor/github.com/spf13/cobra",
        "//vendor/go.uber.org/zap",
        "//vendor/go.uber.org/zap/zapcore",
    ],
)

go_binary(
    name = "assisted-migration-agent",
    embed = [":assisted-migration-agent_lib"],
    visibility = ["//visibility:public"],
)
