go_test(
    name = "server_test",
    srcs = [
        "http_test.go",
        "server_suite_test.go",
    ],
    deps = [
        ":server",
        "//internal/config",
        "//vendor/github.com/gin-gonic/gin",
        "//vendor/github.com/onsi/ginkgo/v2:ginkgo",
        "//vendor/github.com/onsi/gomega",
    ],
