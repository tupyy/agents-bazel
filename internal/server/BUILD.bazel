load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "doc.go",
        "http.go",
    ],
    importpath = "github.com/kubev2v/assisted-migration-agent/internal/server",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/config",
        "//internal/server/middlewares",
        "//pkg/certificates",
        "//vendor/github.com/getkin/kin-openapi/openapi3",
        "//vendor/github.com/gin-contrib/zap",
        "//vendor/github.com/gin-gonic/gin",
        "//vendor/github.com/oapi-codegen/gin-middleware",
        "//vendor/go.uber.org/zap",
    ],
