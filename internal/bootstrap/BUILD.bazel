load("@rules_go//go:def.bzl", "go_library", "go_test")

filegroup(
    name = "core_srcs",
    srcs = ["bootstrap.go", "builder.go"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "bootstrap",
    srcs = [
        ":core_srcs",
        "default_bootstrap.go",
    ],
    importpath = "github.com/kubev2v/assisted-migration-agent/internal/bootstrap",
    visibility = ["//visibility:public"],
    deps = [
        "//api/v2:api",
        "//internal/config",
        "//internal/handlers",
        "//internal/handlers/v2:handlers",
        "//internal/models",
        "//internal/server",
        "//internal/services",
        "//internal/store",
        "//internal/store/migrations",
        "//pkg/console",
        "//pkg/crypto",
        "@com_github_gin_gonic_gin//:go_default_library",
        "@com_github_gin_gonic_gin//binding:go_default_library",
        "@com_github_go_playground_validator_v10//:go_default_library",
        "@com_github_google_uuid//:go_default_library",
        "@com_github_kubev2v_migration_planner//pkg/opa:go_default_library",
        "@org_uber_go_zap//:go_default_library",
    ],
)

go_test(
    name = "bootstrap_test",
    srcs = ["builder_test.go"],
    embed = [":bootstrap"],
    deps = [
        "//internal/config",
        "//internal/server",
        "//internal/store",
        "@com_github_gin_gonic_gin//:go_default_library",
        "@com_github_kubev2v_migration_planner//pkg/opa:go_default_library",
    ],
)
